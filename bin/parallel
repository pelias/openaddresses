#!/bin/bash

# grab the number of workers count
count=$1

# remove the first argument from the arguments array ($@)
shift

# only do anything if count is a valid integer >= 1
if [[ $count -gt 1 ]]; then
	echo "openaddresses: starting $count parallel builds"

	# the importer runs the workers itself, this just sets the parallelism
	# (which takes priority over imports.openaddresses.parallelism)
	export OPENADDRESSES_PARALLELISM=$count
fi

exec ./bin/start $@
